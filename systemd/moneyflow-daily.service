# Intended as a USER-level systemd unit: install to ~/.config/systemd/user/
# on the VPS, then `systemctl --user enable --now moneyflow-daily.timer`.
# %h expands to the deploying user's home. Paths assume the default clone
# location: git clone https://github.com/kyledeveloper/stock-sector-fund-tracker ~/stock-sector-fund-tracker
# Cloned elsewhere? Override without editing this file:
#   systemctl --user edit moneyflow-daily.service
# then set WorkingDirectory=, Environment=PYTHONPATH=... and ExecStart= (clear it
# first with an empty ExecStart= line) to your clone path.
# (For a system-wide unit instead, replace %h with the absolute repo path
# and add User=/Group=.)
[Unit]
Description=US Money Flow Tracker - daily pipeline
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/stock-sector-fund-tracker
# Runtime config, e.g. MONEYFLOW_CONTACT_EMAIL=you@example.com (SEC requires a
# contact email in the User-Agent; M4 fails loud without it). Optional file.
EnvironmentFile=-%h/.config/moneyflow/env
Environment=PYTHONPATH=%h/stock-sector-fund-tracker/src
ExecStart=%h/stock-sector-fund-tracker/.venv/bin/python -m moneyflow.pipeline.daily run-all
