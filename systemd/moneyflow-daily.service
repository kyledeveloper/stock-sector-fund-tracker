# Intended as a USER-level systemd unit: install to ~/.config/systemd/user/
# on the VPS, then `systemctl --user enable --now moneyflow-daily.timer`.
# %h expands to the deploying user's home -- no hardcoded paths.
# (For a system-wide unit instead, replace %h with the absolute repo path
# and add User=/Group=.)
[Unit]
Description=US Money Flow Tracker - daily pipeline
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/workspace/us-moneyflow
Environment=PYTHONPATH=%h/workspace/us-moneyflow/src
ExecStart=%h/workspace/us-moneyflow/.venv/bin/python -m moneyflow.pipeline.daily run-all
